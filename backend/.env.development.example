# ==========================================
# TraceIQ Backend - Development Environment
# ==========================================
ENVIRONMENT=development

# ------------------------------------------
# Database & Cache (Local)
# ------------------------------------------
# Local PostgreSQL with pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traceiq_dev
# Local Redis (for Celery tasks)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------
# AI & Embeddings (100% Free via Google AI Studio / Gemini or OpenAI)
# ------------------------------------------
# Get a free API key with 1,500 req/min at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini/gemini-embedding-2
EMBEDDING_DIMENSIONS=384
LLM_MODEL=gemini/gemini-1.5-flash

# Optional: OpenAI or Custom LiteLLM Provider
OPENAI_API_KEY=
LLM_BASE_URL=
CELERY_ALWAYS_EAGER=true

# ------------------------------------------
# Authentication (Clerk - Development Instance)
# ------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# ------------------------------------------
# GitHub App Integration (Optional / Dev App)
# ------------------------------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------
# Cloudflare R2 Storage (Optional for Dev)
# ------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=traceiq-dev-bucket
R2_ENDPOINT_URL=

# ------------------------------------------
# App & CORS Configuration
# ------------------------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SNAPSHOT_DIR=data/snapshots
