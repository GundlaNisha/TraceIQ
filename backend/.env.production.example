# ==========================================
# TraceIQ Backend - Production Environment
# ==========================================
ENVIRONMENT=production

# ------------------------------------------
# Database & Cache (Cloud)
# ------------------------------------------
# PostgreSQL (Supabase / Neon / Render Postgres with pgvector enabled)
# Format: postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@your-postgres-host.supabase.co:5432/postgres?ssl=require

# Upstash Redis (TLS enabled)
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379

# ------------------------------------------
# AI & Embeddings
# ------------------------------------------
OPENAI_API_KEY=sk-your-openai-production-api-key
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------
# Authentication (Clerk - Production Instance)
# ------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# ------------------------------------------
# GitHub App Integration
# ------------------------------------------
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# ------------------------------------------
# Cloudflare R2 Storage (Optional)
# ------------------------------------------
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=traceiq-prod-bucket
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# ------------------------------------------
# App & CORS Configuration (Vercel Frontend)
# ------------------------------------------
FRONTEND_URL=https://your-traceiq-app.vercel.app
ALLOWED_ORIGINS=https://your-traceiq-app.vercel.app
SNAPSHOT_DIR=data/snapshots
