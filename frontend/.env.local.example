NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=false

# Clerk Authentication Configuration
# These are automatically set by Clerk CLI, but you can manually configure them:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
# CLERK_SECRET_KEY=sk_test_your-key-here
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# For Clerk OAuth configuration (Google, GitHub, etc.):
# 1. Go to Clerk Dashboard: https://dashboard.clerk.com
# 2. Navigate to your application -> Configure -> SSO Connections
# 3. Enable Google and/or GitHub OAuth providers
# 4. Configure OAuth credentials in the respective provider consoles
# 5. Set callback URLs to your Clerk application URLs